<bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="1701.0" y="597.0" width="30.0" height="30.0" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="gw_fail_di" bpmnElement="gw_fail" isMarkerVisible="true"><dc:Bounds x="1114.8" y="784.8" width="50.4" height="50.4" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_reject_di" bpmnElement="t_reject"><dc:Bounds x="1200.0" y="780.0" width="120.0" height="60.0" /></bpmndi:BPMNShape>
