<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="fashion_cnn_retrain_definitions" targetNamespace="https://github.com/Nikita777-coder/ml-productions-proj-urfu">
<bpmn:collaboration id="collaboration">
<bpmn:participant id="participant" name="Автоматическое переобучение модели FashionCNN" processRef="retrain_process" />
</bpmn:collaboration>
<bpmn:process id="retrain_process" name="Переобучение FashionCNN" isExecutable="false">
<bpmn:laneSet id="laneset"><bpmn:lane id="lane_monitor" name="Мониторинг и оркестратор"><bpmn:flowNodeRef>start_timer</bpmn:flowNodeRef><bpmn:flowNodeRef>start_cond</bpmn:flowNodeRef><bpmn:flowNodeRef>start_msg</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_launch</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_data" name="Подготовка данных"><bpmn:flowNodeRef>t_extract</bpmn:flowNodeRef><bpmn:flowNodeRef>t_pre</bpmn:flowNodeRef><bpmn:flowNodeRef>t_validate</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_data</bpmn:flowNodeRef><bpmn:flowNodeRef>t_dataset</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_train" name="Обучение и проверка качества"><bpmn:flowNodeRef>t_train</bpmn:flowNodeRef><bpmn:flowNodeRef>t_eval</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_qa</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_deploy" name="Model Registry и деплой"><bpmn:flowNodeRef>t_register</bpmn:flowNodeRef><bpmn:flowNodeRef>t_canary</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_canary</bpmn:flowNodeRef><bpmn:flowNodeRef>t_promote</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_fail" name="Обработка неуспеха"><bpmn:flowNodeRef>gw_fail</bpmn:flowNodeRef><bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef><bpmn:flowNodeRef>t_rollback</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_fail2</bpmn:flowNodeRef><bpmn:flowNodeRef>end_fail</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start_timer" name="Еженедельно (по расписанию)"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="start_cond" name="Деградация метрик или ≥ 5000 меток"><bpmn:outgoing>f2</bpmn:outgoing><bpmn:conditionalEventDefinition><bpmn:condition xsi:type="bpmn:tFormalExpression">correction_rate &gt; 0.05 or manual_review_rate &gt; 0.35 or new_labels &gt;= 5000</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:startEvent id="start_msg" name="Ручной запуск ML-инженером"><bpmn:outgoing>f3</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
<bpmn:exclusiveGateway id="gw_start" name=""><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_launch" name="Запустить пайплайн, зафиксировать причину и run ID"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:dataStoreReference id="store_log" name="Лог предсказаний и исправлений" />
<bpmn:serviceTask id="t_extract" name="Выгрузить метки, подтверждённые модератором"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:property id="prop_d1" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="d1"><bpmn:sourceRef>store_log</bpmn:sourceRef><bpmn:targetRef>prop_d1</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="t_pre" name="Предобработать: grayscale, 28×28, Normalize"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_validate" name="Проверить данные: формат, метки, дубли, баланс"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_data" name="Данные валидны?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_dataset" name="Объединить с Fashion-MNIST, split train/val, версия"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_train" name="Обучить FashionCNN (train.py), лучшая эпоха по val"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_eval" name="Оценить (evaluate.py), сравнить с production, pytest + smoke-тест"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_qa" name="Все пороги пройдены и не хуже production?"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_register" name="Зарегистрировать fashion_cnn vN (статус Staging)"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:dataOutputAssociation id="d2"><bpmn:targetRef>store_reg</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:dataStoreReference id="store_reg" name="Model Registry" />
<bpmn:serviceTask id="t_canary" name="Canary-деплой: 10% трафика на 24 часа"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_canary" name="Онлайн-метрики не хуже production?"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing><bpmn:outgoing>f19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_promote" name="Перевести vN в Production, старую в Archived"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="end_ok" name="Новая версия в эксплуатации"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="gw_fail" name=""><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_reject" name="Оставить production- модель, кандидат → Rejected + отчёт"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_rollback" name="Откатить трафик на предыдущую версию"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_fail2" name=""><bpmn:incoming>f22</bpmn:incoming><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="end_fail" name="Уведомление ML-инженеру"><bpmn:incoming>f24</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start_timer" targetRef="gw_start" />
<bpmn:sequenceFlow id="f2" sourceRef="start_cond" targetRef="gw_start" />
<bpmn:sequenceFlow id="f3" sourceRef="start_msg" targetRef="gw_start" />
<bpmn:sequenceFlow id="f4" sourceRef="gw_start" targetRef="t_launch" />
<bpmn:sequenceFlow id="f5" sourceRef="t_launch" targetRef="t_extract" />
<bpmn:sequenceFlow id="f6" sourceRef="t_extract" targetRef="t_pre" />
<bpmn:sequenceFlow id="f7" sourceRef="t_pre" targetRef="t_validate" />
<bpmn:sequenceFlow id="f8" sourceRef="t_validate" targetRef="gw_data" />
<bpmn:sequenceFlow id="f9" name="Да" sourceRef="gw_data" targetRef="t_dataset" />
<bpmn:sequenceFlow id="f10" name="Нет" sourceRef="gw_data" targetRef="gw_fail" />
<bpmn:sequenceFlow id="f11" sourceRef="t_dataset" targetRef="t_train" />
<bpmn:sequenceFlow id="f12" sourceRef="t_train" targetRef="t_eval" />
<bpmn:sequenceFlow id="f13" sourceRef="t_eval" targetRef="gw_qa" />
<bpmn:sequenceFlow id="f14" name="Да" sourceRef="gw_qa" targetRef="t_register" />
<bpmn:sequenceFlow id="f15" name="Нет" sourceRef="gw_qa" targetRef="gw_fail" />
<bpmn:sequenceFlow id="f16" sourceRef="t_register" targetRef="t_canary" />
<bpmn:sequenceFlow id="f17" sourceRef="t_canary" targetRef="gw_canary" />
<bpmn:sequenceFlow id="f18" name="Да" sourceRef="gw_canary" targetRef="t_promote" />
<bpmn:sequenceFlow id="f19" name="Нет" sourceRef="gw_canary" targetRef="t_rollback" />
<bpmn:sequenceFlow id="f20" sourceRef="t_promote" targetRef="end_ok" />
<bpmn:sequenceFlow id="f21" sourceRef="gw_fail" targetRef="t_reject" />
<bpmn:sequenceFlow id="f22" sourceRef="t_reject" targetRef="gw_fail2" />
<bpmn:sequenceFlow id="f23" sourceRef="t_rollback" targetRef="gw_fail2" />
<bpmn:sequenceFlow id="f24" sourceRef="gw_fail2" targetRef="end_fail" />
<bpmn:textAnnotation id="ann_thresholds"><bpmn:text>Пороги допуска (шаг «Все пороги пройдены?»):
• accuracy на тесте ≥ 90%, не ниже production &gt; 0.5 п.п.
• accuracy на golden-наборе ≥ production
• macro-F1 ≥ 0.90, F1 каждого класса ≥ 0.70
• при пороге 0.9: coverage ≥ 70%, accuracy ≥ 98%</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="a1" sourceRef="ann_thresholds" targetRef="t_eval" />
</bpmn:process>
<bpmndi:BPMNDiagram id="diagram">
<bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
<bpmndi:BPMNShape id="participant_di" bpmnElement="participant" isHorizontal="true"><dc:Bounds x="0" y="0" width="1764.0" height="900.0" /></bpmndi:BPMNShape>
