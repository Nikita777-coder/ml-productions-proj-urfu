<bpmndi:BPMNShape id="gw_fail2_di" bpmnElement="gw_fail2" isMarkerVisible="true"><dc:Bounds x="1588.8" y="784.8" width="50.4" height="50.4" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="end_fail_di" bpmnElement="end_fail"><dc:Bounds x="1701.0" y="795.0" width="30.0" height="30.0" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ann_thresholds_di" bpmnElement="ann_thresholds"><dc:Bounds x="798.0" y="609.0" width="312.0" height="93.0" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="213.0" y="36.0" /><di:waypoint x="276.0" y="36.0" /><di:waypoint x="276.0" y="64.8" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="213.0" y="90.0" /><di:waypoint x="250.8" y="90.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="213.0" y="144.0" /><di:waypoint x="276.0" y="144.0" /><di:waypoint x="276.0" y="115.2" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="301.2" y="90.0" /><di:waypoint x="330.0" y="90.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="390.0" y="120.0" /><di:waypoint x="390.0" y="240.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d1_di" bpmnElement="d1"><di:waypoint x="270.0" y="270.0" /><di:waypoint x="330.0" y="270.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="450.0" y="270.0" /><di:waypoint x="462.0" y="270.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="582.0" y="270.0" /><di:waypoint x="594.0" y="270.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="714.0" y="270.0" /><di:waypoint x="742.8" y="270.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="793.2" y="270.0" /><di:waypoint x="828.0" y="270.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="768.0" y="295.2" /><di:waypoint x="768.0" y="810.0" /><di:waypoint x="1114.8" y="810.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="888.0" y="300.0" /><di:waypoint x="888.0" y="420.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="948.0" y="450.0" /><di:waypoint x="966.0" y="450.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1086.0" y="450.0" /><di:waypoint x="1114.8" y="450.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1165.2" y="450.0" /><di:waypoint x="1248.0" y="450.0" /><di:waypoint x="1248.0" y="582.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1140.0" y="475.2" /><di:waypoint x="1140.0" y="784.8" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="d2_di" bpmnElement="d2"><di:waypoint x="1248.0" y="642.0" /><di:waypoint x="1248.0" y="669.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f16_di" bpmnElement="f16"><di:waypoint x="1308.0" y="612.0" /><di:waypoint x="1326.0" y="612.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f17_di" bpmnElement="f17"><di:waypoint x="1446.0" y="612.0" /><di:waypoint x="1474.8" y="612.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f18_di" bpmnElement="f18"><di:waypoint x="1525.2" y="612.0" /><di:waypoint x="1554.0" y="612.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f19_di" bpmnElement="f19"><di:waypoint x="1500.0" y="637.2" /><di:waypoint x="1500.0" y="780.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f20_di" bpmnElement="f20"><di:waypoint x="1674.0" y="612.0" /><di:waypoint x="1701.0" y="612.0" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f21_di" bpmnElement="f21"><di:waypoint x="1165.2" y="810.0" /><di:waypoint x="1200.0" y="810.0" /></bpmndi:BPMNEdge>
