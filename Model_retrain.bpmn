<bpmndi:BPMNShape id="store_reg_di" bpmnElement="store_reg"><dc:Bounds x="1218.0" y="669.0" width="60.0" height="42.0" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_canary_di" bpmnElement="t_canary"><dc:Bounds x="1326.0" y="582.0" width="120.0" height="60.0" /></bpmndi:BPMNShape>
